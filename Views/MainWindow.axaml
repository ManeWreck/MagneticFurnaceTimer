<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MagneticFurnaceTimer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="MagneticFurnaceTimer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Контроль магнитной печи"
        Width="1180" Height="760" MinWidth="980" MinHeight="680"
        Background="#0B1120">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#111B2E" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#24324A" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="#24324A" />
      <Setter Property="Foreground" Value="#38BDF8" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="КОНТРОЛЬ МАГНИТНОЙ ПЕЧИ" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" />
        <TextBlock Text="Профиль и время окончания" Foreground="#F8FAFC" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="{Binding StatusBrush}" CornerRadius="18" Padding="16,8">
        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="Bold" />
      </Border>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="1.2*,1*,1*" ColumnSpacing="16">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Classes="caption" Text="КОНФИГУРАЦИЯ EXCEL" />
          <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding ProfileName}" Foreground="#F8FAFC" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SourceFileName}" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
          </StackPanel>
          <Button Grid.Row="2" Classes="secondary" Content="Открыть Excel…" Click="OpenExcel_Click" HorizontalAlignment="Left" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Classes="caption" Text="ВРЕМЯ ЗАПУСКА (ЧАСЫ ПК)" />
          <Grid Grid.Row="1" ColumnDefinitions="1.15*,1*" ColumnSpacing="10">
            <DatePicker SelectedDate="{Binding StartDate}" />
            <TimePicker Grid.Column="1" SelectedTime="{Binding StartTime}" ClockIdentifier="24HourClock" MinuteIncrement="1" />
          </Grid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Запустить" Command="{Binding StartRunCommand}" />
            <Button Classes="secondary" Content="Сбросить" Command="{Binding ResetRunCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <Grid RowDefinitions="Auto,*,Auto,*" RowSpacing="4">
          <TextBlock Classes="caption" Text="ОБЩАЯ ДЛИТЕЛЬНОСТЬ" />
          <TextBlock Grid.Row="1" Text="{Binding TotalDurationText}" Classes="metric" />
          <TextBlock Grid.Row="2" Classes="caption" Text="ИЗВЛЕЧЬ ИЗ ПЕЧИ" Margin="0,8,0,0" />
          <TextBlock Grid.Row="3" Text="{Binding PlannedEndText}" Foreground="#FBBF24" FontSize="19" FontWeight="Bold" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10">
      <Border Background="#7F1D1D" CornerRadius="8" Padding="12,8" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FEE2E2" TextWrapping="Wrap" />
      </Border>

      <TabControl Grid.Row="1" Background="Transparent">
        <TabItem Header="Ход процесса">
          <ScrollViewer>
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16" Margin="0,14,0,0">
              <Border Classes="card" Background="{Binding StatusBrush}" Padding="26">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                  <TextBlock Text="{Binding CurrentStageText}" Foreground="White" FontSize="30" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1" Text="{Binding CurrentStageDetails}" Foreground="#E2E8F0" FontSize="15" />
                  <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="32" Margin="0,12,0,0">
                    <StackPanel>
                      <TextBlock Text="ОСТАЛОСЬ ЭТАПУ" Foreground="#CBD5E1" FontSize="12" />
                      <TextBlock Text="{Binding StageRemainingText}" Foreground="White" FontSize="42" FontFamily="Consolas" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="ДО ОКОНЧАНИЯ ПРОФИЛЯ" Foreground="#CBD5E1" FontSize="12" />
                      <TextBlock Text="{Binding TotalRemainingText}" Foreground="White" FontSize="42" FontFamily="Consolas" FontWeight="Bold" />
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="32">
                    <ProgressBar Value="{Binding StageProgress}" Minimum="0" Maximum="100" />
                    <ProgressBar Grid.Column="1" Value="{Binding TotalProgress}" Minimum="0" Maximum="100" />
                  </Grid>
                </Grid>
              </Border>

              <TextBlock Grid.Row="1" Text="Переходы между этапами" Foreground="#F8FAFC" FontSize="17" FontWeight="SemiBold" />
              <ItemsControl Grid.Row="2" ItemsSource="{Binding Schedule}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StageRowViewModel">
                    <Border Background="#111B2E" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="50,2.2*,1.1*,1.1*,100" ColumnSpacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StepText}" Foreground="#64748B" FontSize="18" FontWeight="Bold" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Label}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding TemperatureText}" Foreground="#94A3B8" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="НАЧАЛО" Foreground="#64748B" FontSize="10" />
                          <TextBlock Text="{Binding StartText}" Foreground="#CBD5E1" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                          <TextBlock Text="КОНЕЦ" Foreground="#64748B" FontSize="10" />
                          <TextBlock Text="{Binding EndText}" Foreground="#FBBF24" />
                        </StackPanel>
                        <Border Grid.Column="4" Background="{Binding StatusBrush}" CornerRadius="12" Padding="8,5">
                          <TextBlock Text="{Binding StatusText}" Foreground="White" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Статичное расписание">
          <ScrollViewer>
            <StackPanel Margin="0,14,0,0">
              <Grid ColumnDefinitions="50,2.2*,1*,1*,1*,1*,100" ColumnSpacing="12" Margin="14,0,14,8">
                <TextBlock Text="#" Classes="caption" />
                <TextBlock Grid.Column="1" Text="ЭТАП" Classes="caption" />
                <TextBlock Grid.Column="2" Text="ТЕМПЕРАТУРА" Classes="caption" />
                <TextBlock Grid.Column="3" Text="ДЛИТЕЛЬНОСТЬ" Classes="caption" />
                <TextBlock Grid.Column="4" Text="НАЧАЛО" Classes="caption" />
                <TextBlock Grid.Column="5" Text="ОКОНЧАНИЕ" Classes="caption" />
                <TextBlock Grid.Column="6" Text="СТАТУС" Classes="caption" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Schedule}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StageRowViewModel">
                    <Border Background="#111B2E" CornerRadius="8" Padding="14,11" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="50,2.2*,1*,1*,1*,1*,100" ColumnSpacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StepText}" Foreground="#64748B" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding TemperatureText}" Foreground="#CBD5E1" />
                        <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#CBD5E1" />
                        <TextBlock Grid.Column="4" Text="{Binding StartText}" Foreground="#CBD5E1" />
                        <TextBlock Grid.Column="5" Text="{Binding EndText}" Foreground="#FBBF24" />
                        <Border Grid.Column="6" Background="{Binding StatusBrush}" CornerRadius="12" Padding="8,5">
                          <TextBlock Text="{Binding StatusText}" Foreground="White" HorizontalAlignment="Center" FontSize="11" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
