<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MagneticFurnaceTimer.ViewModels"
        xmlns:model="using:MagneticFurnaceTimer.Models"
        xmlns:controls="using:MagneticFurnaceTimer.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="MagneticFurnaceTimer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/furnace-timer.ico"
        Title="{DynamicResource AppTitle}"
        Width="1180" Height="760" MinWidth="920" MinHeight="640"
        Background="#0B1120">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#111B2E" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="FontSize" Value="27" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="16,9" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#24324A" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="TextBox.timeInput">
      <Setter Property="Background" Value="#0B1323" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="#24324A" />
      <Setter Property="Foreground" Value="#38BDF8" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="20" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="{DynamicResource HeaderOverline}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" />
        <TextBlock Text="{DynamicResource HeaderTitle}" Foreground="#F8FAFC" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="#111B2E" BorderBrush="#27364D" BorderThickness="1" CornerRadius="7" Padding="12,7">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Fill="{Binding SelectedFurnace.StatusBrush}" />
          <TextBlock Text="{Binding SelectedFurnace.StatusText}" Foreground="#E2E8F0" FontSize="11" FontWeight="Bold" />
        </StackPanel>
      </Border>
      <ComboBox Grid.Column="2" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                Width="145" Background="#111B2E" Foreground="#E2E8F0">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="model:LanguageOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <ListBox Grid.Row="1" ItemsSource="{Binding Furnaces}" SelectedItem="{Binding SelectedFurnace}"
             Background="Transparent" BorderThickness="0" Padding="0">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FurnaceRunViewModel">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="8,5" MinHeight="38">
            <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding DisplayName}" Foreground="#F8FAFC" FontWeight="Bold" />
              <TextBlock Text="{Binding SelectorSummary}" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ContentControl Grid.Row="2" Content="{Binding SelectedFurnace}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:FurnaceRunViewModel">
          <Grid RowDefinitions="Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="1.1*,1.1*,0.9*" ColumnSpacing="14">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="9">
          <TextBlock Classes="caption" Text="{Binding ConfigurationCaption}" />
          <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding ProfileName}" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding SourceFileName}" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="7">
            <Button Classes="primary" Content="{DynamicResource CloudButton}" Click="OpenCloud_Click" />
            <Button Classes="secondary" Content="{DynamicResource LocalFileButton}" Click="OpenExcel_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
          <TextBlock Classes="caption" Text="{DynamicResource StartTimeCaption}" />
          <Grid Grid.Row="1" ColumnDefinitions="1.35*,0.85*" ColumnSpacing="8">
            <StackPanel Spacing="3">
              <TextBlock Classes="caption" Text="{DynamicResource DateCaption}" />
              <TextBox Classes="timeInput" Text="{Binding StartDateText}" Watermark="21.08.2026" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Classes="caption" Text="{DynamicResource TimeCaption}" />
              <TextBox Classes="timeInput" Text="{Binding StartTimeText}" Watermark="17:27" />
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="2" Text="{Binding StartInputHint}" Foreground="#64748B" FontSize="10" />
          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="7">
            <Button Classes="primary" Content="{DynamicResource StartButton}" Command="{Binding StartRunCommand}" />
            <Button Classes="secondary" Content="{DynamicResource NowButton}" Command="{Binding SetNowCommand}" />
            <Button Classes="secondary" Content="{DynamicResource ResetButton}" Command="{Binding ResetRunCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <Grid RowDefinitions="Auto,*,Auto,*" RowSpacing="3">
          <TextBlock Classes="caption" Text="{DynamicResource TotalDurationCaption}" />
          <TextBlock Grid.Row="1" Text="{Binding TotalDurationText}" Classes="metric" />
          <TextBlock Grid.Row="2" Classes="caption" Text="{DynamicResource RemoveCaption}" Margin="0,7,0,0" />
          <TextBlock Grid.Row="3" Text="{Binding PlannedEndText}" Foreground="#FBBF24" FontSize="17" FontWeight="Bold" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8">
      <Border Background="#7F1D1D" CornerRadius="7" Padding="11,7" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FEE2E2" TextWrapping="Wrap" />
      </Border>

      <TabControl Grid.Row="1" Background="Transparent">
        <TabItem Header="{DynamicResource LiveTab}">
          <ScrollViewer>
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" Margin="0,12,0,0">
              <Border Classes="card" Padding="0">
                <Grid ColumnDefinitions="6,*">
                  <Border Background="{Binding StatusBrush}" CornerRadius="12,0,0,12" />
                  <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" Margin="20,17">
                    <TextBlock Text="{Binding CurrentStageText}" Foreground="#F8FAFC" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{Binding CurrentStageDetails}" Foreground="#94A3B8" FontSize="13" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="26" Margin="0,7,0,0">
                      <StackPanel>
                        <TextBlock Text="{DynamicResource StageRemainingCaption}" Classes="caption" />
                        <TextBlock Text="{Binding StageRemainingText}" Foreground="#F8FAFC" FontSize="34" FontFamily="Consolas" FontWeight="Bold" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource ProfileRemainingCaption}" Classes="caption" />
                        <TextBlock Text="{Binding TotalRemainingText}" Foreground="#F8FAFC" FontSize="34" FontFamily="Consolas" FontWeight="Bold" />
                      </StackPanel>
                    </Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="26">
                      <ProgressBar Value="{Binding StageProgress}" Minimum="0" Maximum="100" />
                      <ProgressBar Grid.Column="1" Value="{Binding TotalProgress}" Minimum="0" Maximum="100" />
                    </Grid>
                  </Grid>
                </Grid>
              </Border>

              <Border Grid.Row="1" Classes="card" IsVisible="{Binding HasProfile}">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource TemperatureProfileTitle}" Foreground="#F8FAFC" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="{DynamicResource TemperatureDisclaimer}" Foreground="#64748B" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="RTC LIVE" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                  </Grid>
                  <Grid Grid.Row="1" ColumnDefinitions="3.4*,1*" ColumnSpacing="18">
                    <Border Background="#0B1323" BorderBrush="#1E2D43" BorderThickness="1" CornerRadius="8" Padding="7">
                      <controls:TemperatureProfileControl Height="255"
                                                          Points="{Binding TemperaturePoints}"
                                                          CurrentMinute="{Binding CurrentMinute}"
                                                          TotalMinutes="{Binding ProfileTotalMinutes}"
                                                          CurrentTemperature="{Binding ExpectedTemperature}" />
                    </Border>
                    <Grid Grid.Column="1" RowDefinitions="*,*,*,*" RowSpacing="7">
                      <Border Background="#0B1323" CornerRadius="7" Padding="12,9">
                        <StackPanel>
                          <TextBlock Text="{DynamicResource ExpectedTemperatureCaption}" Classes="caption" />
                          <TextBlock Text="{Binding ExpectedTemperatureText}" Foreground="#38BDF8" FontSize="21" FontWeight="Bold" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Row="1" Background="#0B1323" CornerRadius="7" Padding="12,9">
                        <StackPanel>
                          <TextBlock Text="{DynamicResource SetpointCaption}" Classes="caption" />
                          <TextBlock Text="{Binding SetTemperatureText}" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Row="2" Background="#0B1323" CornerRadius="7" Padding="12,9">
                        <StackPanel>
                          <TextBlock Text="{DynamicResource RateCaption}" Classes="caption" />
                          <TextBlock Text="{Binding CurrentRateText}" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Row="3" Background="#0B1323" CornerRadius="7" Padding="12,9">
                        <StackPanel>
                          <TextBlock Text="{DynamicResource ElapsedCaption}" Classes="caption" />
                          <TextBlock Text="{Binding ElapsedProfileText}" Foreground="#FBBF24" FontSize="16" FontFamily="Consolas" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Grid>
                </Grid>
              </Border>

              <TextBlock Grid.Row="2" Text="{DynamicResource TransitionsTitle}" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" />
              <ItemsControl Grid.Row="3" ItemsSource="{Binding Schedule}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StageRowViewModel">
                    <Border Background="#111B2E" CornerRadius="7" Padding="13,9" Margin="0,0,0,5">
                      <Grid ColumnDefinitions="42,2.2*,1.1*,1.1*,90" ColumnSpacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StepText}" Foreground="#64748B" FontSize="17" FontWeight="Bold" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Label}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding TemperatureText}" Foreground="#94A3B8" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="{DynamicResource StartCaption}" Classes="caption" />
                          <TextBlock Text="{Binding StartText}" Foreground="#CBD5E1" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                          <TextBlock Text="{DynamicResource EndCaption}" Classes="caption" />
                          <TextBlock Text="{Binding EndText}" Foreground="#FBBF24" FontSize="12" />
                        </StackPanel>
                        <Border Grid.Column="4" Background="{Binding StatusBrush}" CornerRadius="10" Padding="7,4">
                          <TextBlock Text="{Binding StatusText}" Foreground="White" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{DynamicResource StaticTab}">
          <ScrollViewer>
            <StackPanel Margin="0,12,0,0">
              <Grid ColumnDefinitions="42,2.2*,1*,1*,1*,1*,90" ColumnSpacing="10" Margin="13,0,13,7">
                <TextBlock Text="#" Classes="caption" />
                <TextBlock Grid.Column="1" Text="{DynamicResource StageCaption}" Classes="caption" />
                <TextBlock Grid.Column="2" Text="{DynamicResource TemperatureCaption}" Classes="caption" />
                <TextBlock Grid.Column="3" Text="{DynamicResource DurationCaption}" Classes="caption" />
                <TextBlock Grid.Column="4" Text="{DynamicResource StartCaption}" Classes="caption" />
                <TextBlock Grid.Column="5" Text="{DynamicResource FinishCaption}" Classes="caption" />
                <TextBlock Grid.Column="6" Text="{DynamicResource StatusCaption}" Classes="caption" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Schedule}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StageRowViewModel">
                    <Border Background="#111B2E" CornerRadius="7" Padding="13,10" Margin="0,0,0,5">
                      <Grid ColumnDefinitions="42,2.2*,1*,1*,1*,1*,90" ColumnSpacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StepText}" Foreground="#64748B" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding TemperatureText}" Foreground="#CBD5E1" />
                        <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="#CBD5E1" />
                        <TextBlock Grid.Column="4" Text="{Binding StartText}" Foreground="#CBD5E1" FontSize="12" />
                        <TextBlock Grid.Column="5" Text="{Binding EndText}" Foreground="#FBBF24" FontSize="12" />
                        <Border Grid.Column="6" Background="{Binding StatusBrush}" CornerRadius="10" Padding="7,4">
                          <TextBlock Text="{Binding StatusText}" Foreground="White" HorizontalAlignment="Center" FontSize="10" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
          </Grid>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Grid>
</Window>
