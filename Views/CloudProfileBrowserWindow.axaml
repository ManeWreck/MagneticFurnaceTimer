<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MagneticFurnaceTimer.ViewModels"
        xmlns:model="using:MagneticFurnaceTimer.Models"
        x:Class="MagneticFurnaceTimer.Views.CloudProfileBrowserWindow"
        x:DataType="vm:CloudProfileBrowserViewModel"
        Icon="/Assets/furnace-timer.ico"
        Title="{DynamicResource CloudWindowTitle}"
        Width="900" Height="650" MinWidth="720" MinHeight="500"
        Background="#0B1120"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="#24324A" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#0B1323" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel>
        <TextBlock Text="{DynamicResource CloudOverline}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" />
        <TextBlock Text="{DynamicResource CloudTitle}" Foreground="#F8FAFC" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0" />
        <TextBlock Text="{DynamicResource CloudSubtitle}" Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
        <Button Content="{DynamicResource OtherFolderButton}" Click="ChooseFolder_Click" />
        <Button Content="{DynamicResource RefreshButton}" Click="Refresh_Click" IsEnabled="{Binding HasFolder}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="#111B2E" CornerRadius="8" Padding="11,8">
      <TextBlock Text="{Binding RootFolder, FallbackValue=Папка ещё не выбрана}" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="2*,1.1*,Auto" ColumnSpacing="9">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource NameSearchCaption}" Foreground="#94A3B8" FontSize="10" />
        <TextBox Text="{Binding NameQuery}" Watermark="{DynamicResource NameSearchWatermark}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="{DynamicResource ModifiedDateCaption}" Foreground="#94A3B8" FontSize="10" />
        <TextBox Text="{Binding DateText}" Watermark="21.08.2026" />
      </StackPanel>
      <Button Grid.Column="2" Content="{DynamicResource ClearDateButton}" Click="ClearDate_Click" VerticalAlignment="Bottom" />
    </Grid>

    <Border Grid.Row="3" Background="#111B2E" BorderBrush="#27364D" BorderThickness="1" CornerRadius="9">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="2*,1.1*,1.6*" Margin="14,9">
          <TextBlock Text="{DynamicResource NameCaption}" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
          <TextBlock Grid.Column="1" Text="{DynamicResource ModifiedCaption}" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
          <TextBlock Grid.Column="2" Text="{DynamicResource FolderCaption}" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                 Background="Transparent" BorderThickness="0" DoubleTapped="Profile_DoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="model:CloudProfileItem">
              <Grid ColumnDefinitions="2*,1.1*,1.6*" ColumnSpacing="12" Margin="8,7">
                <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" Foreground="#CBD5E1" FontFamily="Consolas" />
                <TextBlock Grid.Column="2" Text="{Binding LocationText}" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel>
        <TextBlock Text="{Binding StatusText}" Foreground="#94A3B8" />
        <TextBlock Text="{Binding DateHint}" Foreground="#F59E0B" FontSize="10" IsVisible="{Binding HasInvalidDate}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
        <Button Content="{DynamicResource CancelButton}" Click="Cancel_Click" />
        <Button Classes="primary" Content="{DynamicResource SelectProfileButton}" Click="OpenSelected_Click" IsEnabled="{Binding HasSelection}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
